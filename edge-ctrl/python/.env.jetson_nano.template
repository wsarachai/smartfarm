# ==============================================================================
# Hardware Pin & Bus Mapping — NVIDIA Jetson Nano (40-Pin Header)
# ==============================================================================
# Linux Kernel GPIO Driver: Tegra GPIO -> gpiochip0 (tegra-gpio)
# On Jetson Nano, gpiochip0 line offset corresponds to Linux sysfs GPIO number.
# ==============================================================================
TARGET_DEVICE=jetson_nano

# --- DS3231 Hardware Real-Time Clock (I2C) ---
# Physical Header Wiring:
#   - VCC: Physical Pin 1 (3.3V) or Pin 2 (5V)
#   - GND: Physical Pin 6 (Ground)
#   - SDA: Physical Pin 3 -> I2C1_SDA -> /dev/i2c-1
#   - SCL: Physical Pin 5 -> I2C1_SCL -> /dev/i2c-1
DS3231_I2C_BUS=1
DS3231_I2C_ADDR=0x68
DS3231_SDA_PIN=3
DS3231_SCL_PIN=5

# --- DHT22 Temperature & Humidity Sensor (Single-Wire Data) ---
# Physical Header Wiring:
#   - VCC: Physical Pin 1 (3.3V Power) or Pin 2 (5V Power)
#   - GND: Physical Pin 9 (Ground)
#   - DATA: Physical Pin 7 -> Tegra GPIO(CC, 4) -> gpiochip0 Line 149
# Note: Connect a 4.7k - 10k ohm pull-up resistor between VCC and DATA pin.
DHT22_GPIO_CHIP=gpiochip0
DHT22_GPIO_LINE=149
DHT22_PIN=149
DHT22_PHYSICAL_PIN=7

# --- Relay Switch / External Fan Control (GPIO Digital Output) ---
# Physical Header Wiring:
#   - VCC: Physical Pin 2 or Pin 4 (5V Power for 5V Relay board)
#   - GND: Physical Pin 14 (Ground)
#   - IN/CTRL: Physical Pin 11 -> Tegra GPIO(Z, 0) -> gpiochip0 Line 200
# Note: Set RELAY_ACTIVE_HIGH=false if your relay module uses Active-Low trigger.
RELAY_GPIO_CHIP=gpiochip0
RELAY_GPIO_LINE=200
RELAY_PIN=200
RELAY_PHYSICAL_PIN=11
RELAY_ACTIVE_HIGH=true
