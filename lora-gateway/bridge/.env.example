# Copy to .env (gitignored) and adjust. The bridge reads these at startup.
# Linux/Jetson: /dev/ttyACM0 (the gateway's ST-LINK VCP). Windows: COMx.
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200
# Where telemetry is POSTed. On the Jetson the web-server is on the same host.
SERVER_URL=http://localhost:3000/api/v1/telemetry
RECONNECT_MS=3000
