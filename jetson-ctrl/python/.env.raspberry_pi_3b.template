# ==============================================================================
# Hardware Pin & Bus Mapping — Raspberry Pi 3 Model B (40-Pin J8 Header)
# ==============================================================================
# Linux Kernel GPIO Driver: pinctrl-bcm2835 / pinctrl-bcm2711 -> gpiochip0
# On Raspberry Pi OS, gpiochip0 line offset N corresponds 1:1 with BCM GPIO N.
# ==============================================================================
TARGET_DEVICE=raspberry_pi_3b

# --- DS3231 Hardware Real-Time Clock (I2C) ---
# Physical Header Wiring:
#   - VCC: Physical Pin 1 (3.3V) or Pin 2 (5V)
#   - GND: Physical Pin 6 (Ground)
#   - SDA: Physical Pin 3 -> BCM GPIO 2 (I2C1_SDA) -> /dev/i2c-1
#   - SCL: Physical Pin 5 -> BCM GPIO 3 (I2C1_SCL) -> /dev/i2c-1
DS3231_I2C_BUS=1
DS3231_I2C_ADDR=0x68
DS3231_SDA_PIN=3
DS3231_SCL_PIN=5

# --- DHT22 Temperature & Humidity Sensor (Single-Wire Data) ---
# Physical Header Wiring:
#   - VCC: Physical Pin 1 (3.3V Power) or Pin 2 (5V Power)
#   - GND: Physical Pin 9 (Ground)
#   - DATA: Physical Pin 7 -> BCM GPIO 4 (GPIO_GCLK) -> gpiochip0 Line 4
# Note: Connect a 4.7k - 10k ohm pull-up resistor between VCC and DATA pin.
DHT22_GPIO_CHIP=gpiochip0
DHT22_GPIO_LINE=4
DHT22_PIN=4
DHT22_PHYSICAL_PIN=7

# --- Relay Switch / External Fan Control (GPIO Digital Output) ---
# Physical Header Wiring:
#   - VCC: Physical Pin 2 or Pin 4 (5V Power for 5V Relay board)
#   - GND: Physical Pin 14 (Ground)
#   - IN/CTRL: Physical Pin 11 -> BCM GPIO 17 (GPIO_GEN0) -> gpiochip0 Line 17
# Note: Most opto-isolated relay modules trigger LOW (0V). Set RELAY_ACTIVE_HIGH=false if active-low.
RELAY_GPIO_CHIP=gpiochip0
RELAY_GPIO_LINE=17
RELAY_PIN=17
RELAY_PHYSICAL_PIN=11
RELAY_ACTIVE_HIGH=true
