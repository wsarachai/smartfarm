# Docker Compose reads this automatically (as `.env`, in the same directory
# as docker-compose.yaml) to fill in the ${...} references in
# docker-compose.yaml. Copy this to `.env` and fill in real values —
# never commit the real `.env`.

# Postgres credentials — used both to initialize the postgres container
# (POSTGRES_USER/PASSWORD/DB env vars) and to build the dashboard's
# DATABASE_URL, so they only need to be set once, here.
POSTGRES_USER=smartfarm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smartfarm

# The `dashboard-backend` MQTT user's password (see docs/mqtt-cloud-bridge.md
# for how it's created on the broker).
DASHBOARD_MQTT_PASSWORD=changeme
