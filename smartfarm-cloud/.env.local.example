# Copy to .env.local for local dev, or set as real env vars in the deployed
# container (see docker-compose.yaml).

# Client-exposed (NEXT_PUBLIC_) since the dashboard needs it in the browser
# to know which hub's data to query.
NEXT_PUBLIC_HUB_ID=rasp-01

# Postgres connection string (see prisma/schema.prisma).
DATABASE_URL=postgresql://smartfarm:smartfarm@localhost:5432/smartfarm

# Self-hosted Mosquitto broker (see docs/mqtt-cloud-bridge.md). Use the
# dashboard-backend credentials created on the broker, not the hub's.
MQTT_URL=wss://mqtt.sarachai.com
MQTT_USERNAME=dashboard-backend
MQTT_PASSWORD=changeme
