# Copy to .env (gitignored) and adjust. Loaded by the systemd unit (EnvironmentFile).
# The LoRa PHY block MUST match the node (water-temp-node F103 sender) exactly.

SERVER_URL=http://localhost:3000/api/v1/telemetry

# LoRa radio (SX1278 @ 433 MHz, matching the node)
LORA_FREQ_HZ=433000000
LORA_SF=9
LORA_BW_CODE=7          # 7 = 125 kHz
LORA_CR_CODE=1          # 1 = 4/5
LORA_PREAMBLE=8
LORA_SYNCWORD=0x12

# Pi wiring (BCM numbers). SPI0 CE0 = /dev/spidev0.0 handles NSS automatically.
SPI_BUS=0
SPI_DEV=0
RESET_PIN=22
DIO0_PIN=25

# node_id -> dashboard device_id (JSON)
NODE_MAP={"1":"water-temp-01"}
