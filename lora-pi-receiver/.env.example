# Copy to .env (gitignored). Loaded by the systemd unit (EnvironmentFile).
# IMPORTANT: systemd EnvironmentFile does NOT strip inline "# comments" after a
# value — keep comments on their own lines (like these), never after VALUE.
# The LoRa PHY block MUST match the node (water-temp-node F103 sender) exactly.

SERVER_URL=http://localhost:3000/api/v1/telemetry

# LoRa radio (SX1278 @ 433 MHz, matching the node).
# LORA_BW_CODE: 7 = 125 kHz.  LORA_CR_CODE: 1 = 4/5.
LORA_FREQ_HZ=433000000
LORA_SF=9
LORA_BW_CODE=7
LORA_CR_CODE=1
LORA_PREAMBLE=8
LORA_SYNCWORD=0x12

# Pi wiring (BCM numbers). SPI0 CE0 = /dev/spidev0.0 handles NSS automatically.
SPI_BUS=0
SPI_DEV=0
RESET_PIN=22
DIO0_PIN=25

# node_id -> dashboard device_id (JSON)
NODE_MAP={"1":"water-temp-01"}

# Probe index -> dashboard metric name. Exactly 6 entries (a v4 frame's probe
# slots); a v1/v2/v3 node only fills the first two.
#
# Probes 0 and 1 keep the historic names on purpose: they sit in the same wire
# slots they always did, so leaving them alone keeps the dashboard's existing
# temp_hot / temp_cold history as ONE continuous series. Rename to suit the
# install (e.g. ["temp_inlet","temp_return","temp_tank_top",...]) — but a renamed
# probe starts a NEW series; the old one stops rather than continues.
PROBE_METRICS=["temp_hot","temp_cold","temp_p2","temp_p3","temp_p4","temp_p5"]

# Air sensor index -> metric names. Exactly 3 entries each (a v5 frame's air
# slots); a v2/v3/v4 node only fills the first.
#
# A v5 node carries THREE SHT45s. They all answer to the same factory-fixed 0x44
# and are separated on the node by a bus switch, so "which sensor is which" is
# decided by mux channel -- see water-temp-node/docs/hardware-interface.md.
# Sensor 0 keeps the historic names so existing dashboard history stays ONE
# continuous series; a renamed sensor starts a NEW series.
AIR_METRICS=["air_temp","air_temp_2","air_temp_3"]
HUM_METRICS=["humidity","humidity_2","humidity_3"]

# Site elevation in metres. When > 0, adds a `pressure_msl` metric (BME280 station
# pressure reduced to mean sea level, the ~1013-style figure weather apps show).
# 0 = report raw station pressure only.
ALTITUDE_M=310
