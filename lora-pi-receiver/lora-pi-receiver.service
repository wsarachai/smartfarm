[Unit]
Description=Smart Farm LoRa Pi receiver (SX1278 -> web-server telemetry)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# EDIT User + the two paths to match YOUR install. The example matches a clone at
# /home/pi/workspace/smartfarm/lora-pi-receiver run as the 'pi' user (pi is in the
# 'spi' and 'gpio' groups by default, so it can reach /dev/spidev0.0 + the gpiochip).
User=pi
WorkingDirectory=/home/pi/workspace/smartfarm/lora-pi-receiver
# .env is OPTIONAL — all settings have sensible defaults. The leading '-' means
# systemd won't fail to start if the file is absent.
EnvironmentFile=-/home/pi/workspace/smartfarm/lora-pi-receiver/.env
ExecStart=/usr/bin/python3 receiver.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
